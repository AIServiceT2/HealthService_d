FK\n        int seq PK\n        jsonb frames \"얼굴 제외 관절 좌표\"\n        timestamp received_at\n    }\n    WORKOUT_SUBMISSION {\n        uuid id PK\n        uuid user_id FK\n        uuid session_id FK \"UNIQUE\"\n        string exercise_code FK\n        string status \"SUBMITTED~REVOKED 9개\"\n        timestamp started_at\n        timestamp ended_at\n        int counted_reps \"서버 재계산 인정량\"\n        int version \"If-Match 동시 수정 검사\"\n        float confidence \"0~1, 기준 미확정\"\n        string approval_path \"AI_AUTO / REVIEWER\"\n        text ai_story \"L3\"\n        text ai_form_tip \"L4\"\n        text ai_summary \"L1\"\n        text ai_flags \"L2\"\n    }\n    REP_EVENT {\n        uuid submission_id PK, FK\n        int rep_no PK\n        timestamp ts\n        bool counted \"인정 여부\"\n        jsonb keypoints \"얼굴 제외 관절 좌표 묶음\"\n    }\n    SUBMISSION_SNAPSHOT {\n        uuid submission_id PK, FK\n        string catalog_version\n        int hit_count\n        int exp\n        int total_damage\n        float weakness_multiplier\n        int drop_count\n    }\n    DAILY_CAP_RESERVATION {\n        uuid submission_id PK, FK\n        int amount \"보상 대상 인정량\"\n        timestamp released_at \"취소·반려 시 해제\"\n    }\n    REVIEW_REQUEST {\n        uuid submission_id PK, FK\n        uuid reviewer_user_id FK \"신청자 본인 불가\"\n        timestamp requested_at\n        string reason_code FK \"반려 때 필수\"\n        text reason_text \"반려 때 필수\"\n    }\n    REWARD_LEDGER {\n        uuid submission_id PK, FK \"멱등 키\"\n        timestamp rewarded_at \"보호 기간 = +24시간\"\n    }\n    ITEM {\n        uuid id PK\n        uuid user_id FK\n        uuid submission_id FK\n        string status \"LOCKED / 해제 이름 미정\"\n    }\n    GUILD_INVITATION {\n        string code PK\n        uuid guild_id FK\n        uuid created_by FK \"길드장\"\n        timestamp expires_at\n    }"
