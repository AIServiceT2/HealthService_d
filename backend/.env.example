# 복사해서 .env로 쓰거나 셸에서 export. 실제 비밀 값은 저장소에 올리지 않는다.
DATABASE_URL=postgresql+psycopg://postgres@localhost:5432/jeonunsi
JWT_SECRET=
LLM_PROVIDER=mock # mock(모의 응답) | openai
OPENAI_API_KEY= # OpenAI API 키 (예시 파일에는 비워 둠)
OPENAI_MODEL=gpt-6-luna # 쓸 저가 모델 이름 (OpenAI 공식 모델·가격표에서 확인 후)
OPENAI_TIMEOUT_SEC=10 # 호출 시간 제한
